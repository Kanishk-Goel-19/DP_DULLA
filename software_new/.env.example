# Optional: copy this file to .env and fill in the values.
PORT=3000
HOST=127.0.0.1

# For real four-digit OTP emails sent through a Gmail account:
# 1. Enable Google's 2-Step Verification on the sender account.
# 2. Create a Gmail App Password (not your regular Gmail password).
# 3. Set both values below. Otherwise the OTP appears in the server terminal for local testing.
SMTP_USER=
SMTP_APP_PASSWORD=

# The U1 ESP_MASTER WebSocket URL. Set this when the hardware is ready.
# Examples depend on the actual ESP32 firmware's address and WebSocket path.
ESP32_WS_URL=

# Set to true to bypass the ESP32 connection check during local testing
# (or run `npm run start:bypass` / `npm run dev:bypass`).
ESP32_BYPASS=
